{
  "expo": {
    "name": "Recettes familiales",
    "slug": "recettes-familiales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "recettesfamiliales",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.morel.recettesfamiliales"
    },
    "android": {
      "package": "fr.morel.recettesfamiliales",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permet d'ajouter des photos à vos recettes.",
          "cameraPermission": "Permet de prendre une photo pour l'ajouter à une recette."
        }
      ],
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permet de piloter le mode assistant à la voix (« suivant », « répète », « minuteur 10 minutes »…).",
          "speechRecognitionPermission": "Permet de comprendre les commandes vocales du mode assistant.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eaa7dbd9-fd9d-4a7a-a94c-ec3dbd0274cf"
      }
    }
  }
}
