# Copier ce fichier en ".env" et renseigner les valeurs de votre projet Supabase
# EXISTANT (Project Settings > API sur https://supabase.com/dashboard) — pas besoin
# d'en créer un nouveau, cette app vit dans son propre schéma "recettes" au sein
# de ce projet (voir supabase/setup.sql à exécuter une fois).
# Ne jamais commiter le fichier ".env" réel (déjà ignoré par .gitignore).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
