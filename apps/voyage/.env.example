# Copier ce fichier en ".env" (dans ce dossier apps/voyage) et renseigner
# les valeurs du projet Supabase commun aux apps de la famille
# (Project Settings > API) : les mêmes que pour l'app Cuisine.
# Ne jamais commiter le fichier ".env" réel (déjà ignoré par .gitignore).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Adresse du site web commun (sans / final), pour les liens partagés sur
# WhatsApp depuis un téléphone. Ex. https://famille-morel.netlify.app
EXPO_PUBLIC_URL_SITE=
