# Copier ce fichier en ".env" (dans ce dossier apps/quotidien) et renseigner
# les valeurs du projet Supabase commun aux apps de la famille
# (Project Settings > API) : les mêmes que pour les autres apps.
# Ne jamais commiter le fichier ".env" réel (déjà ignoré par .gitignore).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Adresse du site web commun (sans / final), pour les liens envoyés aux
# parents invités sans compte depuis un téléphone. Ex. https://famille.netlify.app
EXPO_PUBLIC_URL_SITE=
